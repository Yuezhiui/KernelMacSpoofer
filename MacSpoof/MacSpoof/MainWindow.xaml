<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MacSpoof.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MacSpoof">

    <Grid RequestedTheme="Dark">
        <Grid.Resources>
            <SolidColorBrush x:Key="CardBrush" Color="#FF141A22" />
            <SolidColorBrush x:Key="CardInsetBrush" Color="#FF0E131A" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FF252E3A" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6D8CFF" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF7D99FF" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF5C7BEA" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF98A4B3" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6F7B8A" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
            </Style>
        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0B0F14" Offset="0" />
                <GradientStop Color="#FF0D121A" Offset="0.55" />
                <GradientStop Color="#FF101622" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="20,18,20,16" Spacing="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="12" Background="#FFE9EEFF" VerticalAlignment="Center">
                        <Image Width="24" Height="24">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/material-shield-lock.svg" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="MacSpoof" FontSize="24" FontWeight="SemiBold" Foreground="#FFF5F7FA" />
                        <TextBlock Text="Private connection identity controls" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="9,5"
                            CornerRadius="12"
                            BorderBrush="#FF2C3746"
                            BorderThickness="1"
                            Background="#FF151D28"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="#FF69D19A" VerticalAlignment="Center" />
                            <TextBlock Text="READY" FontSize="10" FontWeight="SemiBold" Foreground="#FFC5CFDB" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" CornerRadius="9" Background="#FFF2F4F7" VerticalAlignment="Center">
                                <Image Width="19" Height="19">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/material-wifi.svg" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Network adapter" FontSize="13" FontWeight="SemiBold" Foreground="#FFF0F3F7" />
                                <TextBlock Text="Choose the interface to manage" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <Button x:Name="RefreshAdapterButton"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    Padding="7"
                                    Background="#FFF2F4F7"
                                    BorderThickness="0"
                                    Click="RefreshAdapterButton_Click"
                                    ToolTipService.ToolTip="Refresh adapters"
                                    AutomationProperties.Name="Refresh network adapters">
                                <Image Width="17" Height="17">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/material-refresh.svg" />
                                    </Image.Source>
                                </Image>
                            </Button>
                        </Grid>

                        <ComboBox x:Name="AdapterComboBox"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  Background="#FF0D1218"
                                  BorderBrush="#FF303A47"
                                  SelectionChanged="AdapterComboBox_SelectionChanged" />

                        <Border Background="{StaticResource CardInsetBrush}"
                                BorderBrush="#FF202936"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="CURRENT MAC" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="#FF17271F">
                                    <TextBlock x:Name="MacStatusTextBlock" Text="ACTIVE" FontSize="9" FontWeight="SemiBold" Foreground="#FF7BDAA6" />
                                </Border>
                                <TextBlock x:Name="CurrentMacTextBlock"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,3,0,0"
                                           Text="Loading..."
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="30"
                                           Foreground="#FFF6F8FB" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="#FFF2F4F7" VerticalAlignment="Center">
                                <Image Width="19" Height="19">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/material-settings-ethernet.svg" />
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Spoof configuration" FontSize="13" FontWeight="SemiBold" Foreground="#FFF0F3F7" />
                                <TextBlock Text="Run once or rotate automatically" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <ComboBox x:Name="ConfigurationComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  Background="#FF0D1218"
                                  BorderBrush="#FF303A47"
                                  SelectionChanged="ConfigurationComboBox_SelectionChanged">
                            <ComboBoxItem Content="Once" />
                            <ComboBoxItem Content="5 Minutes" />
                            <ComboBoxItem Content="10 Minutes" />
                            <ComboBoxItem Content="15 Minutes" />
                            <ComboBoxItem Content="30 Minutes" />
                            <ComboBoxItem Content="1 Hour" />
                            <ComboBoxItem Content="12 Hours" />
                            <ComboBoxItem Content="24 Hours" />
                        </ComboBox>

                        <CheckBox x:Name="ClearCacheCheckBox"
                                  Content="Refresh network caches after each change"
                                  IsChecked="True"
                                  FontSize="11"
                                  Foreground="#FFB7C0CC" />
                    </StackPanel>
                </Border>

                <Button x:Name="ActionButton"
                        HorizontalAlignment="Stretch"
                        Height="48"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="#FF090D12"
                        BorderThickness="0"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon x:Name="ActionButtonIcon" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="ActionButtonText" Text="RUN SPOOF" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ClearCacheButton"
                            Height="40"
                            Background="#FF171E27"
                            BorderBrush="#FF2B3542"
                            BorderThickness="1"
                            Foreground="#FFD6DCE5"
                            Click="ClearCacheButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Clear cache" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton"
                            Grid.Column="1"
                            Height="40"
                            Background="#FF171E27"
                            BorderBrush="#FF2B3542"
                            BorderThickness="1"
                            Foreground="#FFD6DCE5"
                            Click="RestoreButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Restore MAC" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="#FF10161E"
                        BorderBrush="#FF202A36"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11,8">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Ready. MAC changes briefly disconnect the adapter."
                               TextWrapping="Wrap"
                               FontSize="10.5"
                               Foreground="#FF9DA8B6"
                               MaxLines="2" />
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="Minimize to keep MacSpoof available in the system tray"
                               FontSize="9.5"
                               Foreground="#FF667283"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Segoe UI Variable · Native Windows UI"
                               FontSize="8.5"
                               Foreground="#FF4E5967"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
