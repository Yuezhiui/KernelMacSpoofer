<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MacSpoof.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MacSpoof">

    <Grid RequestedTheme="Light" Background="#FFF9F8F4">
        <Grid.Resources>
            <SolidColorBrush x:Key="InkBrush" Color="#FF111111" />
            <SolidColorBrush x:Key="PaperBrush" Color="#FFFDFCF8" />
            <SolidColorBrush x:Key="SoftPaperBrush" Color="#FFF4F3EF" />
            <SolidColorBrush x:Key="MutedInkBrush" Color="#FF555555" />
            <SolidColorBrush x:Key="DisabledInkBrush" Color="#FF9A9A96" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Background" Value="{StaticResource PaperBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderThickness" Value="1.6" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Background" Value="{StaticResource PaperBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>
        </Grid.Resources>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,12" Spacing="8">

                <!-- Product header -->
                <Grid Margin="4,0,4,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="50"
                            Height="50"
                            CornerRadius="12"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1.7"
                            Background="{StaticResource PaperBrush}">
                        <Image Width="27" Height="27">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/material-shield-lock.svg" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="-1">
                        <TextBlock Text="MacSpoof"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   CharacterSpacing="-10" />
                        <TextBlock Text="Private connection identity control"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedInkBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Network adapter card -->
                <Border CornerRadius="13"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1.6"
                        Background="{StaticResource PaperBrush}"
                        Padding="11,9">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Width="27" Height="27" VerticalAlignment="Center">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-wifi.svg" />
                                </Image.Source>
                            </Image>

                            <StackPanel Grid.Column="1"
                                        Margin="9,0,8,0"
                                        VerticalAlignment="Center"
                                        Spacing="-1">
                                <TextBlock Text="Network Adapter"
                                           FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Select the network interface to manage"
                                           FontSize="8.7"
                                           Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>

                            <Button x:Name="RefreshAdapterButton"
                                    Grid.Column="2"
                                    Width="80"
                                    Height="34"
                                    Padding="8,0"
                                    Click="RefreshAdapterButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Image Width="15" Height="15">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/material-refresh.svg" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="Refresh"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ComboBox x:Name="AdapterComboBox"
                                  MinHeight="39"
                                  Padding="8,2"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AdapterComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Current MAC -->
                <Border CornerRadius="13"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1.6"
                        Background="{StaticResource PaperBrush}"
                        Padding="11,9">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="21" Height="21">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-network.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Current MAC Address"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border CornerRadius="10"
                                BorderBrush="#FFB6B6B1"
                                BorderThickness="1.2"
                                Background="#FFFFFFFF"
                                Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CurrentMacTextBlock"
                                           Text="Loading..."
                                           FontSize="20"
                                           FontWeight="Bold"
                                           CharacterSpacing="5"
                                           VerticalAlignment="Center" />

                                <Button x:Name="CopyMacButton"
                                        Grid.Column="1"
                                        Width="39"
                                        Height="34"
                                        Padding="0"
                                        ToolTipService.ToolTip="Copy MAC address"
                                        Click="CopyMacButton_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8C8;"
                                              FontSize="17" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Spoof configuration -->
                <Border CornerRadius="13"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1.6"
                        Background="{StaticResource PaperBrush}"
                        Padding="11,9">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Width="22" Height="22" VerticalAlignment="Center">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-settings.svg" />
                                </Image.Source>
                            </Image>

                            <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="-1">
                                <TextBlock Text="Spoof Configuration"
                                           FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Choose how to run the spoof"
                                           FontSize="8.7"
                                           Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="OnceModeButton"
                                    Height="66"
                                    Padding="9,5"
                                    Background="{StaticResource SoftPaperBrush}"
                                    BorderThickness="1.8"
                                    Click="OnceModeButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="17" Height="17" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="OnceRadioDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource InkBrush}" />
                                    </Grid>

                                    <Image Grid.Column="1" Width="23" Height="23" VerticalAlignment="Center">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/material-play.svg" />
                                        </Image.Source>
                                    </Image>

                                    <StackPanel Grid.Column="2"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="-1">
                                        <TextBlock Text="Once" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Run manually" FontSize="8.2" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="CustomModeButton"
                                    Grid.Column="1"
                                    Height="66"
                                    Padding="9,5"
                                    Click="CustomModeButton_Click">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Width="160" Spacing="6">
                                            <TextBlock Text="Custom interval"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Choose how often the MAC changes."
                                                       FontSize="8.2"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ComboBox x:Name="ConfigurationComboBox"
                                                      MinHeight="32"
                                                      HorizontalAlignment="Stretch"
                                                      SelectedIndex="2"
                                                      SelectionChanged="ConfigurationComboBox_SelectionChanged">
                                                <ComboBoxItem Content="5 Minutes" />
                                                <ComboBoxItem Content="10 Minutes" />
                                                <ComboBoxItem Content="15 Minutes" />
                                                <ComboBoxItem Content="30 Minutes" />
                                                <ComboBoxItem Content="1 Hour" />
                                                <ComboBoxItem Content="12 Hours" />
                                                <ComboBoxItem Content="24 Hours" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="17" Height="17" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="CustomRadioDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="Transparent" />
                                    </Grid>

                                    <Image Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/material-settings.svg" />
                                        </Image.Source>
                                    </Image>

                                    <StackPanel Grid.Column="2"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="-1">
                                        <TextBlock Text="Custom" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Set interval" FontSize="8.2" Foreground="{StaticResource MutedInkBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <CheckBox x:Name="ClearCacheCheckBox"
                                  IsChecked="True"
                                  FontSize="9.7">
                            <CheckBox.Resources>
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF111111" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF222222" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FF000000" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
                            </CheckBox.Resources>
                            <StackPanel Spacing="-1">
                                <TextBlock Text="Refresh network caches after each change"
                                           FontSize="9.7" />
                                <TextBlock Text="Helps apply the new MAC address immediately"
                                           FontSize="7.9"
                                           Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Main action -->
                <Button x:Name="ActionButton"
                        Height="45"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource SoftPaperBrush}"
                        BorderThickness="1.9"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Image Width="20" Height="20">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/material-play.svg" />
                            </Image.Source>
                        </Image>
                        <TextBlock x:Name="ActionButtonText"
                                   Text="RUN SPOOF"
                                   FontSize="14"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Secondary actions -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ClearCacheButton"
                            Height="38"
                            Click="ClearCacheButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-clean.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Clear Cache" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton"
                            Grid.Column="1"
                            Height="38"
                            Click="RestoreButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <Image Width="16" Height="16">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-restore.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Restore Original MAC"
                                       FontSize="9.5"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Adapter information -->
                <Border CornerRadius="13"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1.6"
                        Background="{StaticResource PaperBrush}"
                        Padding="11,8">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="18" Height="18">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/material-info.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Adapter Information"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <Grid Margin="23,0,0,0" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name" FontSize="9" />
                            <TextBlock x:Name="AdapterNameTextBlock"
                                       Grid.Column="1"
                                       Text="—"
                                       FontSize="9" />

                            <TextBlock Grid.Row="1" Text="Status" FontSize="9" />
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                <Ellipse x:Name="AdapterStatusDot"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource InkBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="AdapterStatusTextBlock"
                                           Text="Connected"
                                           FontSize="9" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Link Speed" FontSize="9" />
                            <TextBlock x:Name="AdapterSpeedTextBlock"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Text="—"
                                       FontSize="9" />

                            <TextBlock Grid.Row="3" Text="Driver Version" FontSize="9" />
                            <TextBlock x:Name="AdapterDriverTextBlock"
                                       Grid.Row="3"
                                       Grid.Column="1"
                                       Text="Windows managed"
                                       FontSize="9" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock"
                           Visibility="Collapsed"
                           Text="Ready." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
