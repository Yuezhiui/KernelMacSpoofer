<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MacSpoof.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacSpoof"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MacSpoof">

    <Grid RequestedTheme="Dark">
        <!-- DeepSeek-style Blue Wave Gradient Background -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <!-- Overlay to enhance contrast and depth -->
        <Grid Background="#2A050B14" />

        <StackPanel Margin="24" Spacing="20" MaxWidth="400" VerticalAlignment="Center">
            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="MacSpoof" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Configure your connection identity" FontSize="14" Foreground="#99B8E6" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Current Target Card -->
            <Border BorderBrush="#305A8DD9" BorderThickness="1" CornerRadius="12" Padding="20" Background="#380D1A30">
                <StackPanel Spacing="8">
                    <TextBlock Text="CURRENT TARGET" FontSize="12" FontWeight="SemiBold" Foreground="#88A4D0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CurrentMacTextBlock" Text="MAC: Loading..." FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Choose Configuration -->
            <StackPanel Spacing="8">
                <TextBlock Text="CHOOSE CONFIGURATION" FontSize="12" FontWeight="SemiBold" Foreground="#88A4D0"/>
                <ComboBox x:Name="ConfigurationComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" Background="#380D1A30" BorderBrush="#305A8DD9" CornerRadius="8" SelectionChanged="ConfigurationComboBox_SelectionChanged">
                    <ComboBoxItem Content="Once" />
                    <ComboBoxItem Content="5 Seconds" />
                    <ComboBoxItem Content="10 Seconds" />
                    <ComboBoxItem Content="30 Seconds" />
                    <ComboBoxItem Content="5 Minutes" />
                    <ComboBoxItem Content="10 Minutes" />
                    <ComboBoxItem Content="15 Minutes" />
                    <ComboBoxItem Content="30 Minutes" />
                    <ComboBoxItem Content="1 Hour" />
                    <ComboBoxItem Content="12 Hours" />
                    <ComboBoxItem Content="24 Hours" />
                </ComboBox>
            </StackPanel>

            <!-- Action Button -->
            <Button x:Name="ActionButton" HorizontalAlignment="Stretch" Height="48" CornerRadius="8" Background="#1D63ED" Foreground="White" Click="ActionButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon x:Name="ActionButtonIcon" Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock x:Name="ActionButtonText" Text="RUN" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>
